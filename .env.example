# 复制为 .env 后修改：cp .env.example .env

# ---- 站点 ----
# 你的域名（DNS A 记录指向服务器 IP 后填写）。留空 = 用 http://服务器IP 访问，不启用 HTTPS。
DOMAIN=
# Cookie 是否只在 HTTPS 下发送。留空时：设置了 DOMAIN 就自动为 true。
COOKIE_SECURE=

# ---- 数据库 ----
POSTGRES_USER=k408
POSTGRES_DB=k408
# 务必改成随机强密码：openssl rand -hex 24
POSTGRES_PASSWORD=change-me-please

# ---- 登录 ----
# 至少 32 个字符，务必随机生成：openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# 登录/注册接口每个 IP 每分钟最多次数
AUTH_RATE_LIMIT_MAX=10

# ---- 其他 ----
LOG_LEVEL=info
# 构建镜像时的 npm 源；国内网络慢可改为 https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org/

# ---- 本地开发（pnpm dev，不用 Docker 时）----
# DATABASE_URL=postgresql://k408:k408@localhost:5432/k408
