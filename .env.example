# 复制为 .env 后修改：cp .env.example .env

# ---- 站点 ----
# 你的域名（DNS A 记录指向服务器 IP 后填写）。留空 = 用 http://服务器IP 访问，不启用 HTTPS。
DOMAIN=
# Cookie 是否只在 HTTPS 下发送。留空时：设置了 DOMAIN 就自动为 true。
COOKIE_SECURE=

# 站点完整地址（如 https://k408.example.com）。填写后构建会生成 sitemap.xml 并写进 robots.txt
SITE_URL=
# ICP 备案号（如 京ICP备12345678号-1）。备案通过后填写，会显示在页脚并链接到工信部备案系统；留空不显示
ICP_BEIAN=
# 运营者联系邮箱，显示在《用户协议》《隐私政策》中（个人信息保护法要求提供联系方式）；留空则写“通过页脚公布的联系方式”
CONTACT_EMAIL=

# ---- 数据库 ----
POSTGRES_USER=k408
POSTGRES_DB=k408
# 务必改成随机强密码：openssl rand -hex 24
POSTGRES_PASSWORD=change-me-please

# ---- 登录 ----
# 至少 32 个字符，务必随机生成：openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# 登录/注册接口每个 IP 每分钟最多次数（宿舍/校园网多人共用出口 IP，不宜过低；单账号另有连错锁定）
AUTH_RATE_LIMIT_MAX=60

# ---- 其他 ----
LOG_LEVEL=info
# 构建镜像时的 npm 源；国内网络慢可改为 https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org/

# ---- 本地开发（pnpm dev，不用 Docker 时）----
# DATABASE_URL=postgresql://k408:k408@localhost:5432/k408
# 国内服务器可选：Debian apt 镜像与 Prisma 引擎镜像
# APT_MIRROR=http://mirrors.cloud.tencent.com
# PRISMA_ENGINES_MIRROR=https://registry.npmmirror.com/-/binary/prisma
