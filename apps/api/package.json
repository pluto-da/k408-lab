{
  "name": "@k408/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsup",
    "start": "node dist/server.js",
    "typecheck": "prisma generate >/dev/null && tsc --noEmit",
    "lint": "eslint src test",
    "test": "prisma generate >/dev/null && vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/jwt": "^10.2.4",
    "@fastify/rate-limit": "^10.1.1",
    "@k408/shared": "workspace:*",
    "@prisma/client": "5.22.0",
    "argon2": "^0.41.1",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "prisma": "5.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "embedded-postgres": "16.4.0-beta.14",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vitest": "^3.2.7"
  }
}
