# SITE_ADDRESS 由 docker-compose 传入：
#   设置了 DOMAIN（如 k408.example.com）→ Caddy 自动申请并续期 HTTPS 证书（需 80/443 端口可达、DNS 已指向本机）
#   未设置 DOMAIN → 退化为 ":80"，用服务器 IP 走 http 访问
{
	admin off
}

{$SITE_ADDRESS::80} {
	# 3D 模型（.glb）默认不在 Caddy 的压缩类型里，显式加上
	encode {
		zstd
		gzip
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/xml*
			header Content-Type image/svg+xml*
			header Content-Type application/manifest+json*
			header Content-Type image/x-icon*
			header Content-Type application/wasm*
			header Content-Type model/gltf-binary*
			header Content-Type application/octet-stream*
		}
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' data: blob:; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
		-Server
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	# 带哈希的构建产物：长期缓存；不存在时返回 404（不回落到 index.html）
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# 旧版实验室模块、字体、图标与 PWA 清单（旧模块通过 ?v=构建号 刷新）；不存在时返回真 404
	@static path /legacy/* /fonts/* /icons/* /favicon.svg /favicon.ico /apple-touch-icon.png /manifest.webmanifest
	handle @static {
		root * /srv
		header Cache-Control "public, max-age=86400"
		# Caddy 不认识 .webmanifest 扩展名，补上标准类型（配合 nosniff）
		header /manifest.webmanifest Content-Type "application/manifest+json; charset=utf-8"
		file_server
	}

	# 给爬虫的文件：短缓存，不存在时返回 404（sitemap.xml 只在构建时设置了 SITE_URL 才会生成）
	@seo path /robots.txt /sitemap.xml
	handle @seo {
		root * /srv
		header Cache-Control "public, max-age=3600"
		file_server
	}

	# 单页应用的已知路由 → index.html（200）。新增前端路由时记得同步这里
	@spa path_regexp spa ^/(lab|pc|login|register|profile)?/?$
	handle @spa {
		root * /srv
		header Cache-Control "no-cache"
		rewrite * /index.html
		file_server
	}

	# 其余路径：仍交给前端渲染“页面不存在”，但状态码是 404，避免搜索引擎把错误链接当成正常页面收录
	handle {
		root * /srv
		header Cache-Control "no-cache"
		rewrite * /index.html
		file_server {
			status 404
		}
	}

	log {
		output stdout
		format console
	}
}
