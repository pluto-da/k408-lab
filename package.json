{
  "name": "k408-lab",
  "version": "1.0.0",
  "private": true,
  "description": "考研408动画实验室 · 全栈 v1",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" run dev",
    "build": "pnpm -r --filter \"./apps/*\" run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "check:sources": "node scripts/check-sources.mjs --dist",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:sources",
    "db:migrate": "pnpm --filter @k408/api db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.13.0"
  }
}
